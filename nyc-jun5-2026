<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NYC · Sara Bareilles · Jun 5–6</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1a2e;
    --cream: #faf8f3;
    --gold: #c9a84c;
    --gold-light: #f0e6c8;
    --blush: #e8d5c4;
    --sage: #8aab9a;
    --muted: #7a7a8c;
    --card: #ffffff;
    --border: #e8e4dc;
    --accent: #6b4c8a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--ink);
    min-height: 100vh;
    padding-bottom: 3rem;
  }

  /* HEADER */
  .hero {
    background: var(--ink);
    color: var(--cream);
    padding: 2.5rem 1.25rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 0%, rgba(201,168,76,0.18) 0%, transparent 70%),
                radial-gradient(ellipse at 10% 100%, rgba(107,76,138,0.15) 0%, transparent 60%);
  }
  .hero-eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.6rem;
    font-weight: 500;
    position: relative;
  }
  .hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 2.4rem;
    line-height: 1.1;
    position: relative;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--gold);
  }
  .hero-sub {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: rgba(250,248,243,0.65);
    position: relative;
    font-weight: 300;
  }
  .hero-badges {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.25rem;
    flex-wrap: wrap;
    position: relative;
  }
  .badge {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(201,168,76,0.3);
    border-radius: 100px;
    padding: 0.3rem 0.75rem;
    font-size: 0.72rem;
    color: var(--gold-light);
    letter-spacing: 0.04em;
  }

  /* NAV TABS */
  .tabs {
    display: flex;
    background: var(--ink);
    border-top: 1px solid rgba(255,255,255,0.06);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .tab {
    flex: 1;
    padding: 0.75rem 0.5rem;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(250,248,243,0.45);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    font-family: 'DM Sans', sans-serif;
  }
  .tab.active {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  /* SECTIONS */
  .section { display: none; padding: 1.25rem; }
  .section.active { display: block; }

  /* WEATHER BAR */
  .weather-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .weather-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    text-align: center;
  }
  .weather-day { font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.3rem; }
  .weather-temp { font-family: 'DM Serif Display', serif; font-size: 1.8rem; color: var(--ink); }
  .weather-desc { font-size: 0.72rem; color: var(--muted); margin-top: 0.2rem; }

  /* DAY HEADER */
  .day-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
  }
  .day-header h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.35rem;
  }
  .day-pill {
    background: var(--gold);
    color: var(--ink);
    border-radius: 100px;
    padding: 0.2rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* TIMELINE */
  .timeline { position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 1.1rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--gold-light), var(--border));
  }

  .event {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    position: relative;
  }
  .event-dot {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--cream);
    border: 2px solid var(--border);
    flex-shrink: 0;
    margin-top: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    z-index: 1;
  }
  .event.highlight .event-dot {
    background: var(--gold);
    border-color: var(--gold);
    font-size: 0.7rem;
  }
  .event.star .event-dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(107,76,138,0.2);
  }

  .event-card {
    flex: 1;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.85rem 1rem;
  }
  .event.highlight .event-card {
    border-color: var(--gold-light);
    background: #fffdf5;
  }
  .event.star .event-card {
    border-color: rgba(107,76,138,0.25);
    background: #f9f7fc;
  }

  .event-time {
    font-size: 0.68rem;
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }
  .event-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }
  .event.star .event-title { color: var(--accent); }
  .event-detail {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.3rem;
    line-height: 1.45;
  }
  .event-options {
    margin-top: 0.5rem;
    background: var(--cream);
    border-radius: 8px;
    padding: 0.5rem 0.65rem;
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .event-options strong { color: var(--ink); }

  /* MAP LINKS */
  .map-section { margin-top: 1rem; }
  .map-section h3 {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .map-grid { display: flex; flex-direction: column; gap: 0.5rem; }
  .map-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s;
  }
  .map-link:active { border-color: var(--gold); }
  .map-icon { font-size: 1.2rem; flex-shrink: 0; }
  .map-name { font-size: 0.88rem; font-weight: 500; }
  .map-addr { font-size: 0.72rem; color: var(--muted); margin-top: 0.1rem; }
  .map-arrow { margin-left: auto; color: var(--muted); font-size: 0.8rem; }

  /* CHECKLIST */
  .checklist-group { margin-bottom: 1.25rem; }
  .checklist-group h3 {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 0.6rem;
    padding-left: 0.25rem;
  }
  .checklist-items { display: flex; flex-direction: column; gap: 0.35rem; }
  .check-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.7rem 0.9rem;
    cursor: pointer;
    transition: all 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .check-item.done {
    background: var(--cream);
    border-color: var(--sage);
  }
  .check-item.done .check-label { text-decoration: line-through; color: var(--muted); }
  .check-box {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 2px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    color: transparent;
    transition: all 0.15s;
  }
  .check-item.done .check-box {
    background: var(--sage);
    border-color: var(--sage);
    color: white;
  }
  .check-label { font-size: 0.85rem; color: var(--ink); }

  /* TIPS */
  .tips-grid { display: flex; flex-direction: column; gap: 0.6rem; }
  .tip-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .tip-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 0.05rem; }
  .tip-text { font-size: 0.82rem; line-height: 1.5; color: var(--ink); }
  .tip-text strong { font-weight: 600; }
</style>
</head>
